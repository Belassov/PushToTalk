#include <windows.h>
#include "resource.h"

IDI_ICON_LIVE  ICON "mic_live.ico"
IDI_ICON_MUTED ICON "mic_muted.ico"
IDI_ICON_OFF   ICON "mic_off.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          0x40004L
FILETYPE        0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "REN3D"
      VALUE "FileDescription",  "Push-to-Talk microphone control"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "PushToTalk"
      VALUE "OriginalFilename", "PushToTalk.exe"
      VALUE "ProductName",      "PushToTalk"
      VALUE "ProductVersion",   "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
